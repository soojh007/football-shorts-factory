SPORTMONKS_API_TOKEN=
EPL_LEAGUE_ID=8
# Enable only if your subscription includes expected goals.
SPORTMONKS_INCLUDE_XG=false

# Milestone 2: separate OpenAI API credential (not your Sportmonks token).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Live web search for pre-match context.
OPENAI_RESEARCH_MODEL=gpt-4.1-mini
# Dedicated personal narration and grounding review.
OPENAI_EDITORIAL_MODEL=gpt-4.1

# Milestone 3: speech settings; reuses OPENAI_API_KEY.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
OPENAI_TTS_SPEED=1.1

# Milestone 5: Google OAuth Desktop app credentials, not an API key.
YOUTUBE_CLIENT_SECRETS=secrets/youtube_client_secret.json
YOUTUBE_TOKEN_FILE=secrets/youtube_token.json
# Set the intended channel's UC... identifier after sign-in.
YOUTUBE_CHANNEL_ID=
